# LLM PROVIDERS (Free Tiers)
# Routing order (router.py TASK_PRIORITY): Mistral first everywhere (6 keys,
# shuffled, highest configured quota), Google AI Studio as the immediate
# fallback, then nvidia-nim/groq/openrouter-free if configured. Within a
# single call(), each provider gets its own exponential-backoff retry (3
# attempts) before the router gives up on it and cascades to the next one —
# so a Mistral timeout retries Mistral first, then falls through to Google,
# not the other way around.
MISTRAL_KEY_1=
MISTRAL_KEY_2=
MISTRAL_KEY_3=
MISTRAL_KEY_4=
MISTRAL_KEY_5=
MISTRAL_KEY_6=
GOOGLE_AI_STUDIO_KEY=
# Google's per-model daily quota varies a lot by tier — check your own
# aistudio.google.com rate-limit dashboard and point this at whichever model
# actually has the request budget you want (a generation's "Flash Lite" tier
# is often several times the RPD of its plain "Flash" tier). Defaults to a
# conservative, known-good model+quota; override once you've checked yours.
GOOGLE_AI_STUDIO_MODEL=gemini-2.5-flash-lite
GOOGLE_AI_STUDIO_RPM=10
GOOGLE_AI_STUDIO_RPD=20
NVIDIA_NIM_KEY=
GROQ_API_KEY=
OPENROUTER_KEY=

# OPPORTUNITY DISCOVERY (all optional, all free — opportunity_scan degrades
# gracefully to LLM-only brainstorming if these are unset)
# Reddit: create a free "script" app at reddit.com/prefs/apps. No client id/secret
# set -> falls back to Reddit's public unauthenticated JSON endpoints.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=survival-agent/1.0
OPPORTUNITY_SUBREDDITS=forhire,slavelabour,SaaS,Entrepreneur,sideproject
# Upwork has no self-serve jobs-search API. Generate a saved-search RSS feed URL
# from your own Upwork account (Saved Searches > RSS) and paste it here.
UPWORK_RSS_URL=

# HUMAN-IN-THE-LOOP APPROVAL (email round trip before any real-world bid)
# The agent will only post a real reply/offer under your identity if
# ENABLE_REAL_BIDDING=true AND you reply to its approval email with
# "APPROVE <token>". Leaving SMTP/IMAP blank means it fails closed — approval
# emails can't be sent, replies can't be checked, so gated actions never fire.
# Gmail example: SMTP/IMAP host below, and use a 16-char Gmail "App Password"
# (myaccount.google.com/apppasswords) for both PASSWORD fields, not your real password.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
APPROVAL_EMAIL_TO=
APPROVAL_TIMEOUT_HOURS=24.0

# Master safety switch for real-world action on sourced listings (Reddit bid
# comments). Defaults to false. Even when true, every action still requires a
# fresh per-opportunity email approval on top of this flag.
ENABLE_REAL_BIDDING=false
# Write-scope Reddit credentials — only needed if ENABLE_REAL_BIDDING=true.
# Separate from REDDIT_CLIENT_ID/SECRET above (those are read-only).
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Master safety switch for REAL deployment: micro_saas actually creates a
# live Vercel page + a real payable Stripe product; content_farm actually
# publishes to a live URL. Defaults to false (fabricated URLs, dice-roll
# revenue, as before). Also requires the same email approval as above.
ENABLE_REAL_DEPLOYMENT=false
# Vercel API token (vercel.com/account/tokens) — required for real deploys.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# STRIPE — required for any real revenue collection (real micro_saas sales,
# real service-bid payments). Use sk_test_/pk_test_ to rehearse with fake
# cards, or sk_live_/pk_live_ once you want real customer charges — the code
# doesn't care which, it just uses whatever key is here.
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_

# GITHUB
GITHUB_TOKEN=ghp_
GITHUB_REPO=yourusername/survival-agent
GITHUB_BRANCH=main

# LANGSMITH
LANGSMITH_API_KEY=ls-
LANGSMITH_PROJECT=survival-agent
LANGSMITH_TRACING=true

# AGENT CONFIG
SEED_BUDGET=100.00
MONTH_1_TARGET=10.00
MONTH_2_TARGET=50.00
MONTH_3_TARGET=200.00
MONTH_4_TARGET=500.00
MONTH_5_TARGET=1000.00
SERVER_BURN_PER_HOUR=0.15
CYCLE_INTERVAL_MINUTES=15
MAX_CONSECUTIVE_FAILURES=5
EMERGENCY_RUNWAY_HOURS=48.0
PANIC_RUNWAY_HOURS=12.0

# MEMORY
WORKING_MEMORY_MAX=20
EPISODIC_DB_PATH=state/episodes.json
SEMANTIC_DB_PATH=state/semantic.json
SKILLS_DIR=state/skills
ENABLE_CACHE=true
CACHE_MAX_SIZE=1000

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=logs/survival-agent.log
